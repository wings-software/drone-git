# syntax=docker/dockerfile:1
# Stage 1: rebuild drone-git from source against an up-to-date Go toolchain so
# the binary embeds the patched stdlib + golang.org/x/crypto (CI-23158).
FROM harness0.harness.io/oci/docker_artifacts/golang:1.25.11 AS drone-git-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' \
        -o /out/drone-git ./

# Stage 2: rebuild git-lfs from source under the same toolchain. The upstream
# release tarball ships a stale go stdlib that drives several criticals.
FROM harness0.harness.io/oci/docker_artifacts/golang:1.25.11 AS git-lfs-builder
ARG GIT_LFS_VERSION=v3.7.1
RUN git clone --depth 1 --branch ${GIT_LFS_VERSION} https://github.com/git-lfs/git-lfs.git /src
WORKDIR /src
# Pull patched x/* modules so the built binary doesn't embed stale crypto/net/sys/text (CI-23158).
RUN go get golang.org/x/crypto@v0.52.0 \
           golang.org/x/net@v0.55.0 \
           golang.org/x/sys@v0.45.0 \
           golang.org/x/text@v0.37.0 && \
    go mod tidy
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' \
        -o /out/git-lfs .

# Declared as a named stage so rootfs-builder can seed /mnt/rootfs from it
# below.
FROM harness0.harness.io/oci/docker_artifacts/redhat/ubi10-micro:10.2 AS micro-base

# Stage 3: runtime rootfs assembly. ubi10-micro ships no package manager, so
# ubi10-minimal is a builder here, not the runtime base.
FROM harness0.harness.io/oci/docker_artifacts/redhat/ubi10-minimal:10.2 AS rootfs-builder
USER root

# Seed the install root with micro's whole filesystem, rpmdb included, so
# microdnf sees micro's baseline as already installed and updates it instead
# of skipping it.
RUN mkdir -p /mnt/rootfs
COPY --from=micro-base / /mnt/rootfs/

RUN microdnf update --installroot /mnt/rootfs \
      --config /etc/dnf/dnf.conf --noplugins \
      --setopt=cachedir=/var/cache/microdnf-installroot \
      --setopt=reposdir=/etc/yum.repos.d \
      --setopt=varsdir=/etc/dnf/vars \
      --nodocs --setopt=install_weak_deps=0 -y \
  && microdnf install --installroot /mnt/rootfs \
      --config /etc/dnf/dnf.conf --noplugins \
      --setopt=cachedir=/var/cache/microdnf-installroot \
      --setopt=reposdir=/etc/yum.repos.d \
      --setopt=varsdir=/etc/dnf/vars \
      --nodocs --setopt=install_weak_deps=0 -y \
    ca-certificates \
    git-core \
    tar \
    openssh-clients \
  && microdnf --installroot /mnt/rootfs \
      --config /etc/dnf/dnf.conf --noplugins \
      --setopt=cachedir=/var/cache/microdnf-installroot \
      --setopt=reposdir=/etc/yum.repos.d \
      --setopt=varsdir=/etc/dnf/vars \
      clean all \
  && rm -rf /mnt/rootfs/var/cache/yum

# git-core (not the full git metapackage): the embedded posix scripts
# (posix/common, posix/clone*) only ever call plumbing (init, fetch,
# checkout, submodule update, sparse-checkout, lfs install, config, remote),
# none of which need perl-Git or the Perl interpreter it drags in. Unlike
# ci-addon, this image genuinely shells out to the OS ssh client
# (GIT_SSH_COMMAND, ssh-keyscan, ssh-keygen in posix/common), so
# openssh-clients is a real runtime dependency here, not stripped.
#
# shadow-utils and perl, present in the pre-migration Dockerfile, are
# dropped: nothing in this image creates a user (it runs as root, same as
# before) or calls perl (grep across posix/*, windows/*, main.go: no hits).
# unzip is build-time only, for extracting the AWS CLI installer below, so
# it's installed into rootfs-builder's own filesystem, not --installroot.

# Install AWS CLI v2 (official binary - no Python/pip transitive
# dependencies) straight into the installroot: posix/common's credential
# helper (`git config --global credential.helper '!aws codecommit
# credential-helper $@'`) depends on it at runtime.
WORKDIR /downloads
# aws/install's symlinks (both the bin/aws, bin/aws_completer launchers and
# the internal v2/current version link) point at the literal -i/-b paths
# given on the command line, so installing straight into /mnt/rootfs/...
# bakes /mnt/rootfs-prefixed targets into the shipped rootfs -- which 404
# once copied to the final image's /. Sweep every symlink under the install
# tree afterward and strip the /mnt/rootfs prefix back off.
RUN microdnf install -y --nodocs unzip \
  && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o awscliv2.zip \
  && unzip -q awscliv2.zip \
  && ./aws/install -i /mnt/rootfs/usr/local/aws-cli -b /mnt/rootfs/usr/local/bin \
  && find /mnt/rootfs/usr/local/aws-cli /mnt/rootfs/usr/local/bin -type l | while read -r link; do \
       target=$(readlink "$link"); \
       case "$target" in /mnt/rootfs/*) ln -sfn "${target#/mnt/rootfs}" "$link" ;; esac; \
     done \
  && rm -rf aws awscliv2.zip

# Remove unnecessary SSL keys
RUN rm -rf /mnt/rootfs/usr/share/doc/perl-IO-Socket-SSL \
          /mnt/rootfs/usr/share/doc/perl-Net-SSLeay/examples/server_key.pem

# FROM scratch, not micro-base: COPY only adds/overwrites, it never deletes,
# so layering the updated rootfs onto micro-base would let any file the
# update removed survive underneath while the overlaid rpmdb reports it
# gone. rootfs-builder already seeded /mnt/rootfs from all of micro-base
# plus the update, so it is the whole filesystem, not a diff.
FROM scratch

COPY --from=rootfs-builder /mnt/rootfs/ /

COPY --from=git-lfs-builder /out/git-lfs /usr/local/bin/git-lfs
RUN chmod +x /usr/local/bin/git-lfs

# Add enhanced binary with embedded scc and telemetry
# The binary embeds all posix scripts, so we don't need to copy them separately
COPY --from=drone-git-builder /out/drone-git /usr/local/bin/drone-git
RUN chmod +x /usr/local/bin/drone-git

# Create symlink for backward compatibility with old entrypoints
RUN ln -s /usr/local/bin/drone-git /usr/local/bin/clone

# Use old entrypoint for backward compatibility (now points to enhanced binary)
ENTRYPOINT ["/usr/local/bin/clone"]
