# syntax=docker/dockerfile:1
# Stage 1: rebuild drone-git from source against an up-to-date Go toolchain so
# the binary embeds the patched stdlib + golang.org/x/crypto (CI-23158).
FROM harness0.harness.io/oci/docker_artifacts/hhi/go:1.26.10@sha256:718fddf012b3a305e936ae9964e5a642036bcb7b4c6c0786e2f78f238d637db8 AS hhi-build-sdk-0
FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7 AS drone-git-builder
COPY --from=hhi-build-sdk-0 /usr/lib/go /usr/lib/go
ENV PATH=/usr/lib/go/bin:$PATH GOPATH=/go GOTOOLCHAIN=local
RUN apk add --no-cache git 'ca-certificates>=20261020-r0'
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -trimpath -ldflags='-s -w' \
        -o /out/drone-git ./

# Rebuild the existing Alpine 3.24 git-lfs 3.7.1 with the patched compiler.
FROM drone-git-builder AS git-lfs-builder
ARG GIT_LFS_VERSION=v3.7.1
RUN git clone --depth 1 --branch ${GIT_LFS_VERSION} https://github.com/git-lfs/git-lfs.git /git-lfs
WORKDIR /git-lfs
# Match the security dependency floors already used by the other plugin builds.
RUN go get golang.org/x/crypto@v0.52.0 \
           golang.org/x/net@v0.55.0 \
           golang.org/x/sys@v0.45.0 \
           golang.org/x/text@v0.37.0 && \
    go mod tidy
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -trimpath -ldflags='-s -w' -o /out/git-lfs .

# Runtime.

FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7
RUN apk add --no-cache 'ca-certificates>=20261020-r0' git openssh curl perl aws-cli sudo

COPY --from=git-lfs-builder /out/git-lfs /usr/local/bin/git-lfs

RUN chmod -R 777 /etc/ssh

# Remove unnecessary SSL keys
RUN rm -rf /usr/share/doc/perl-IO-Socket-SSL \
          /usr/share/doc/perl-Net-SSLeay/examples/server_key.pem


RUN adduser -g Drone -s /bin/sh -D -u 1000 drone
RUN echo 'drone ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/drone
# Add enhanced binary with embedded scc and telemetry
# The binary embeds all posix scripts, so we don't need to copy them separately (ARM64/v8)
COPY --from=drone-git-builder /out/drone-git /usr/local/bin/drone-git
RUN chmod +x /usr/local/bin/drone-git

# Create symlink for backward compatibility with old entrypoints
RUN ln -s /usr/local/bin/drone-git /usr/local/bin/clone

USER drone:drone
RUN chmod -R 777 /home/drone

# Use old entrypoint for backward compatibility (now points to enhanced binary)
ENTRYPOINT ["/usr/local/bin/clone"]
