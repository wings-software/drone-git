# syntax=docker/dockerfile:1
# Stage 1: rebuild drone-git from source against an up-to-date Go toolchain
# so the binary embeds the patched stdlib + golang.org/x/crypto (CI-23158).
FROM harness0.harness.io/oci/docker_artifacts/hhi/go:1.26.10@sha256:718fddf012b3a305e936ae9964e5a642036bcb7b4c6c0786e2f78f238d637db8 AS hhi-build-sdk-1
FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7 AS drone-git-builder
COPY --from=hhi-build-sdk-1 /usr/lib/go /usr/lib/go
ENV PATH=/usr/lib/go/bin:$PATH GOPATH=/go GOTOOLCHAIN=local
RUN apk add --no-cache git 'ca-certificates>=20261020-r0'
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -trimpath -ldflags='-s -w' \
        -o /out/drone-git ./

# Stage 2: rebuild git-lfs from source under the same toolchain.
FROM harness0.harness.io/oci/docker_artifacts/hhi/go:1.26.10@sha256:718fddf012b3a305e936ae9964e5a642036bcb7b4c6c0786e2f78f238d637db8 AS hhi-git-toolchain-1
FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7 AS git-lfs-builder
COPY --from=hhi-git-toolchain-1 /usr/lib/go /usr/lib/go
ENV PATH=/usr/lib/go/bin:$PATH GOPATH=/go GOTOOLCHAIN=local
RUN apk add --no-cache git 'ca-certificates>=20261020-r0'
ARG GIT_LFS_VERSION=v3.7.1
RUN git clone --depth 1 --branch ${GIT_LFS_VERSION} https://github.com/git-lfs/git-lfs.git /src
WORKDIR /src
# Pull patched x/* modules so the built binary doesn't embed stale crypto/net/sys/text (CI-23158).
RUN go get golang.org/x/crypto@v0.52.0 \
           golang.org/x/net@v0.55.0 \
           golang.org/x/sys@v0.45.0 \
           golang.org/x/text@v0.37.0 && \
    go mod tidy
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -trimpath -ldflags='-s -w' \
        -o /out/git-lfs .

# Stage 3: runtime on ubi10-minimal:10.2 for refreshed RPM CVE coverage.
FROM harness0.harness.io/oci/docker_artifacts/redhat/ubi10-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e
USER root

RUN microdnf update -y --nodocs --setopt=install_weak_deps=0 && \
    microdnf install -y --nodocs \
      ca-certificates \
      unzip \
      git \
      tar \
      openssh \
      perl \
      shadow-utils \
      sudo && \
    microdnf clean all

# Install AWS CLI v2
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o awscliv2.zip && \
    unzip -q awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

COPY --from=git-lfs-builder /out/git-lfs /usr/local/bin/git-lfs
RUN chmod +x /usr/local/bin/git-lfs

RUN chmod -R 777 /etc/ssh

# Remove unnecessary SSL keys
RUN rm -rf /usr/share/doc/perl-IO-Socket-SSL \
          /usr/share/doc/perl-Net-SSLeay/examples/server_key.pem

RUN groupadd drone && adduser -g drone -s /bin/sh -u 1000 drone
RUN echo 'drone ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/drone

# Add enhanced binary with embedded scc and telemetry
# The binary embeds all posix scripts, so we don't need to copy them separately (ARM64)
COPY --from=drone-git-builder /out/drone-git /usr/local/bin/drone-git
RUN chmod +x /usr/local/bin/drone-git

# Create symlink for backward compatibility with old entrypoints
RUN ln -s /usr/local/bin/drone-git /usr/local/bin/clone

USER drone:drone
RUN chmod -R 777 /home/drone

# Use old entrypoint for backward compatibility (now points to enhanced binary)
ENTRYPOINT ["/usr/local/bin/clone"]
