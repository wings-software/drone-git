# escape=`

FROM harness0.harness.io/oci/docker_artifacts/golang:1.26.10@sha256:672c944cfd07599b5f1bb179869270cdc94c6254e41db4d431259693cb286b82 AS git-lfs-builder
ENV CGO_ENABLED=0
ENV GOBIN=C:\out
ENV GOTOOLCHAIN=local
RUN go install github.com/git-lfs/git-lfs/v3@v3.7.1

SHELL ["powershell.exe", "-NoLogo", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
WORKDIR C:\src
COPY go.mod go.sum ./
RUN go mod download; if ($LASTEXITCODE -ne 0) { throw 'Go module download failed' }
COPY main.go ./
COPY posix/ ./posix/
COPY windows/ ./windows/
ARG PLUGIN_VERSION=dev
RUN go build -trimpath -ldflags "-s -w -X main.version=$env:PLUGIN_VERSION" -o C:\out\drone-git.exe .; if ($LASTEXITCODE -ne 0) { throw 'drone-git build failed' }

# Build stage - same as original but with cleanup
FROM harness0.harness.io/oci/docker_artifacts/mcr/windows/servercore:ltsc2022@sha256:6b43c814ed2a800563083ce3193e5f1951d4d6a18fd2879ff45173851db82bd5 AS git
SHELL ["powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

RUN [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 ; `
    Invoke-WebRequest -UseBasicParsing https://github.com/git-for-windows/git/releases/download/v2.39.2.windows.1/MinGit-2.39.2-64-bit.zip -OutFile git.zip; `
    Expand-Archive git.zip -DestinationPath C:\git; `
    Remove-Item git.zip -Force

COPY --from=git-lfs-builder C:\out\git-lfs.exe C:\git-lfs\git-lfs-3.7.1\git-lfs.exe

RUN Add-WindowsCapability -Online -Name OpenSSH.Client*

# PowerShell stage - download PowerShell Core manually to avoid heavy base image
FROM harness0.harness.io/oci/docker_artifacts/mcr/windows/servercore:ltsc2022@sha256:6b43c814ed2a800563083ce3193e5f1951d4d6a18fd2879ff45173851db82bd5 AS powershell
SHELL ["powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
RUN [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 ; `
    Invoke-WebRequest -UseBasicParsing https://github.com/PowerShell/PowerShell/releases/download/v7.4.6/PowerShell-7.4.6-win-x64.zip -OutFile powershell.zip; `
    Expand-Archive powershell.zip -DestinationPath C:\PowerShell; `
    Remove-Item powershell.zip -Force

# Git's MSYS runtime requires Win32 APIs that Nano Server does not provide.
FROM harness0.harness.io/oci/docker_artifacts/mcr/windows/servercore:ltsc2022@sha256:6b43c814ed2a800563083ce3193e5f1951d4d6a18fd2879ff45173851db82bd5

# Copy tools from build stages (same as original)
COPY --from=git /git /git
COPY --from=git /git-lfs /git-lfs
COPY --from=git C:\Windows\System32\OpenSSH\ /openssh
COPY --from=powershell /PowerShell /PowerShell

# Keep clone.ps1 compatible with Harness while running the metadata collector.
COPY --from=git-lfs-builder C:\out\drone-git.exe C:\bin\drone-git.exe
COPY windows/clone-entrypoint.ps1 /bin/clone.ps1

# Set PATH (same as original)
ENV PATH="C:\PowerShell;C:\git\cmd;C:\git\mingw64\bin;C:\git\usr\bin;C:\openssh;C:\git-lfs\git-lfs-3.7.1;${PATH}"

# Run as ContainerUser (rootless)
USER ContainerUser
SHELL ["C:\\PowerShell\\pwsh.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
RUN & C:\git\usr\bin\sh.exe --version; if ($LASTEXITCODE -ne 0) { throw "Git shell startup failed: $LASTEXITCODE" }
CMD [ "C:\\PowerShell\\pwsh.exe", "C:\\bin\\clone.ps1" ]
